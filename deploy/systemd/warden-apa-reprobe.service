[Unit]
Description=Re-probe Warden APA protection heartbeats
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=10m
WorkingDirectory=/opt/warden/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/opt/warden/.env
Environment=WARDEN_PROTECTION_DB=/opt/warden/data/protection.db
ExecStart=/usr/bin/flock --exclusive --nonblock /opt/warden/data/.apa-reprobe.lock /opt/warden/current/.venv/bin/python scripts/reprobe_protections.py
User=warden
Group=warden
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/warden/data
