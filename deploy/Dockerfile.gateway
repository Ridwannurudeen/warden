FROM python:3.12-slim

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    WARDEN_GUARD_KEY=/var/lib/warden-gateway/guard_key \
    WARDEN_GUARD_STATE=/var/lib/warden-gateway/state.json

WORKDIR /app

COPY pyproject.toml MANIFEST.in README.md LICENSE ./
COPY warden ./warden
COPY sdk/python ./sdk/python

RUN python -m pip install . "./sdk/python[proxy]" \
    && groupadd --system warden-gateway \
    && useradd --system --gid warden-gateway --home-dir /var/lib/warden-gateway warden-gateway \
    && install -d -o warden-gateway -g warden-gateway -m 0700 /var/lib/warden-gateway

USER warden-gateway

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8787/healthz', timeout=2).read()"]

STOPSIGNAL SIGTERM

ENTRYPOINT ["warden-gateway"]
