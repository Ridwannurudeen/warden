{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warden.gudman.xyz/spec/schemas/apa-log-entry-v0.1.schema.json",
  "title": "APA mixed transparency-log entry v0.1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "event": { "type": "string", "minLength": 1 },
        "attestation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "endpoint_host": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["active", "stale", "key-changed", "revoked", "invalid"]
        },
        "record_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prev_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "seq",
        "ts",
        "event",
        "attestation_id",
        "endpoint_host",
        "status",
        "record_hash",
        "prev_hash"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "event": { "const": "breaker-confirmed" },
        "record_type": { "const": "breaker-certificate" },
        "certificate_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "benchmark_case_id": {
          "type": "string",
          "pattern": "^gauntlet-[0-9a-f]{16}$"
        },
        "record_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prev_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "seq",
        "ts",
        "event",
        "record_type",
        "certificate_id",
        "benchmark_case_id",
        "record_hash",
        "prev_hash"
      ],
      "additionalProperties": false
    }
  ]
}
