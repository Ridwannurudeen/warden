{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warden.gudman.xyz/spec/schemas/apa-log-checkpoint-v0.1.schema.json",
  "title": "APA transparency-log checkpoint v0.1",
  "type": "object",
  "properties": {
    "spec_version": { "const": "apa-log/0.1" },
    "issuer": { "type": "string", "minLength": 1 },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "head_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issuer_sig": {
      "type": "string",
      "pattern": "^sig:[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "spec_version",
    "issuer",
    "seq",
    "head_hash",
    "issued_at",
    "issuer_sig"
  ],
  "additionalProperties": false
}
