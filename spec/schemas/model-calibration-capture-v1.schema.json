{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warden.gudman.xyz/spec/schemas/model-calibration-capture-v1.schema.json",
  "title": "Warden model calibration score capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tier",
    "dataset_id",
    "dataset_sha256",
    "provider",
    "model",
    "captured_at",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "tier": { "enum": ["embedding", "semantic"] },
    "dataset_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "dataset_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provider": { "type": "string", "minLength": 1, "maxLength": 256 },
    "model": { "type": "string", "minLength": 1, "maxLength": 256 },
    "captured_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "label", "score", "source", "reviewed_by"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "label": { "enum": ["attack", "benign"] },
          "score": { "type": "number", "minimum": -1, "maximum": 1 },
          "source": { "type": "string", "minLength": 1, "maxLength": 512 },
          "reviewed_by": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    }
  }
}
