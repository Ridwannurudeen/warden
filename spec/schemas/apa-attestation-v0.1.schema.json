{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warden.gudman.xyz/spec/schemas/apa-attestation-v0.1.schema.json",
  "title": "Agent Protection Attestation v0.1",
  "type": "object",
  "properties": {
    "spec_version": { "const": "apa/0.1" },
    "predicate_type": {
      "const": "https://warden.gudman.xyz/spec/protection/v1"
    },
    "attestation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "issuer": { "type": "string", "minLength": 1 },
    "protector": { "type": "string", "minLength": 1 },
    "endpoint_host": { "type": "string", "minLength": 1 },
    "pub": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"
    },
    "tier": { "enum": ["guard-live", "audited"] },
    "status": {
      "enum": ["active", "stale", "key-changed", "revoked", "invalid"]
    },
    "scans_24h": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        { "type": "null" }
      ]
    },
    "verified_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254737391
    },
    "expires_at": {
      "type": "integer",
      "minimum": 3600,
      "maximum": 9007199254740991
    },
    "issuer_sig": {
      "type": "string",
      "pattern": "^sig:[A-Za-z0-9_-]{86}$"
    },
    "consent_verified": { "const": true },
    "grade": { "type": "string", "minLength": 1, "maxLength": 64 },
    "blocked": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "battery_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "spec_version",
    "predicate_type",
    "attestation_id",
    "issuer",
    "protector",
    "endpoint_host",
    "pub",
    "tier",
    "status",
    "scans_24h",
    "verified_at",
    "expires_at",
    "issuer_sig"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": { "tier": { "const": "guard-live" } },
      "not": {
        "anyOf": [
          { "required": ["consent_verified"] },
          { "required": ["grade"] },
          { "required": ["blocked"] },
          { "required": ["total"] },
          { "required": ["battery_version"] }
        ]
      }
    },
    {
      "properties": { "tier": { "const": "audited" } },
      "required": [
        "consent_verified",
        "grade",
        "blocked",
        "total",
        "battery_version"
      ]
    }
  ]
}
